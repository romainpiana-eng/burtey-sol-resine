# ============================================================
#  Burtey Sol & Résine — configuration Apache (IONOS)
#  Redirections, compression, cache navigateur, sécurité
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ------------------------------------------------------------
#  1. Redirections — une seule URL canonique par page
#     Aujourd'hui http://, https://, www. et /index.html
#     répondent tous 200 : Google voit 4 sites identiques.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http:// -> https://  (IONOS termine le TLS en amont : on teste les deux)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://burtey-sol-resine.fr/$1 [R=301,L]

  # www. -> sans www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://burtey-sol-resine.fr/$1 [R=301,L]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Page 404 personnalisée (au lieu de la page Apache par défaut,
# servie en iso-8859-1 avec les accents cassés)
ErrorDocument 404 /404.html

# ------------------------------------------------------------
#  2. Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  3. Cache navigateur
#     CSS/JS : cache long, la page appelle style.css?v=AAAAMMJJ —
#     changer ce numéro dans le HTML force la mise à jour.
#     HTML : toujours revalidé, pour que les modifications de
#     contenu soient visibles immédiatement.
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/xml                  "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ----------------------------------------------------------
  #  4. En-têtes de sécurité
  # ----------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------
#  5. Types MIME
# ------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

AddDefaultCharset UTF-8
